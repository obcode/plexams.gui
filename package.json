{
	"name": "plexams.gui",
	"version": "0.0.2",
	"author": "Oliver Braun <oliver.braun@hm.edu>",
	"license": "BSD-3-Clause",
	"private": true,
	"packageManager": "pnpm@11.9.0",
	"scripts": {
		"dev": "vite dev",
		"devhost": "vite dev --host",
		"update-schema.graphql": "bash -lc 'set -a && [ -f .env ] && . .env || true; pnpm dlx get-graphql-schema \"$PLEXAMS_SERVER\" > schema.graphql && pnpm codegen'",
		"codegen": "graphql-codegen",
		"build": "vite build",
		"package": "svelte-kit package",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"prepare": "husky"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@graphql-codegen/cli": "^7.4.6",
		"@graphql-codegen/typescript": "^6.1.2",
		"@graphql-codegen/typescript-operations": "^6.2.0",
		"@playwright/test": "1.62.1",
		"@svelte-plugins/tooltips": "^3.0.3",
		"@sveltejs/adapter-node": "^5.5.8",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@vitest/coverage-v8": "^4.1.12",
		"daisyui": "^5.8.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"jsdom": "^30.1.3",
		"lint-staged": "^17.6.2",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"theme-change": "^3.0.4",
		"tslib": "^2.9.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^4.1.12"
	},
	"type": "module",
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,css,html,md,yaml,yml}": "prettier --write"
	},
	"dependencies": {
		"@sentry/sveltekit": "^10.78.0",
		"ansi-to-html": "^0.7.2",
		"dompurify": "^3.4.18",
		"dotenv": "^17.4.2",
		"graphql": "^16.15.0",
		"graphql-request": "^7.4.0",
		"graphql-tag": "^2.12.7",
		"graphql-ws": "^6.4.3",
		"html-to-image": "^1.11.13",
		"jszip": "^3.10.2",
		"marked": "^18.2.1"
	}
}
